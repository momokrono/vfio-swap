# =============================================================================
# VFIO Passthrough Configuration
# Copy to ~/.config/vfio-passthrough.conf (recommended)
# Or to /etc/vfio-passthrough.conf for system-wide defaults
# =============================================================================
#
# NOTE: This file is parsed as key=value pairs, NOT sourced as bash.
# Only simple assignments are supported. No command substitution, variables,
# or complex expressions.

# GPU PCI IDs
# Find your IDs with: lspci -nn | grep -E "VGA|3D|Display"
# Format: DDDD:BB:DD.F (domain:bus:device.function)
GPU_PCI_ID="0000:01:00.0"
GPU_AUDIO_PCI_ID="0000:01:00.1"

# User and group for VFIO device permissions
# The user running the VM needs access to /dev/vfio/<group>
VFIO_USER="user"
VFIO_GROUP="kvm"

# State file location (stores original driver bindings)
# /run is recommended as it's cleared on reboot
STATE_FILE="/run/vfio_state"

# Extra services to stop before GPU passthrough and restart after
# Space or comma-separated list of service names (with or without .service suffix)
# These are stopped IN ADDITION to automatically detected GPU-holding services
# Example: EXTRA_SERVICES="lactd fancontrol"
EXTRA_SERVICES=""
